void setup() {
  
  pinMode(13, OUTPUT);
  pinMode(11, OUTPUT);
  pinMode(12, OUTPUT);
}

void loop() {
  int i=10;
  while(i>0){
  digitalWrite(13, HIGH); //green 10x
  delay(1500); 
    digitalWrite(12, HIGH); 
  delay(1000);
    digitalWrite(11, HIGH); 
  delay(3000);
  digitalWrite(13, LOW);   
  delay(1500);     
  
  
                //  blue 15
  digitalWrite(12, LOW);   
  delay(1000);   
  
  
                  
  digitalWrite(11, LOW);   
  delay(3000);   
  
  i--;
  }
}
