
int waitT = 750; 


String ms1 = "A circle with radius ";
String ms2 = " has an area of ";
String ms3 = ".";


float pi = 3.14;
float r = 2.0;
float area;

void setup() {

  Serial.begin(9600);
}

void loop() {

  area = pi * r * r;


  Serial.print(ms1);   
  Serial.print(r);     
  Serial.print(ms2);   
  Serial.print(area);  
  Serial.println(ms3); 

  
  r = r + 0.5;


  delay(waitT);
}
